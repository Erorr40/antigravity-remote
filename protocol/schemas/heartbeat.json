{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Heartbeat",
  "description": "Host daemon and mobile client presence, health, and status",
  "type": "object",
  "required": ["online", "hostOs", "activeTasksCount", "uptimeSeconds"],
  "properties": {
    "online": { "type": "boolean" },
    "hostOs": { "type": "string" },
    "activeSessionId": { "type": ["string", "null"] },
    "activeTasksCount": { "type": "integer", "minimum": 0 },
    "hostVersion": { "type": "string" },
    "uptimeSeconds": { "type": "integer", "minimum": 0 },
    "loadAverage": { "type": "number" },
    "memoryUsagePercent": { "type": "number" }
  }
}
