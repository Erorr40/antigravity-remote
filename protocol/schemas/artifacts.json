{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifacts",
  "description": "Schemas for listing and viewing session artifacts and diffs",
  "definitions": {
    "ArtifactItem": {
      "type": "object",
      "required": ["fileName", "filePath", "sizeBytes", "modifiedAt"],
      "properties": {
        "fileName": { "type": "string" },
        "filePath": { "type": "string" },
        "sizeBytes": { "type": "integer" },
        "modifiedAt": { "type": "integer" },
        "mimeType": { "type": "string" }
      }
    },
    "ArtifactListResponse": {
      "type": "object",
      "required": ["sessionId", "artifacts"],
      "properties": {
        "sessionId": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/definitions/ArtifactItem" }
        }
      }
    },
    "ArtifactContentResponse": {
      "type": "object",
      "required": ["sessionId", "fileName", "content"],
      "properties": {
        "sessionId": { "type": "string" },
        "fileName": { "type": "string" },
        "mimeType": { "type": "string" },
        "isText": { "type": "boolean" },
        "content": {
          "type": "string",
          "description": "UTF-8 string if isText is true, or Base64 encoded binary if false"
        }
      }
    }
  }
}
